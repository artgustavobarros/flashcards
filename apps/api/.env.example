NODE_ENV=development
PORT=3001
# Matches compose.yaml at the repo root.
DATABASE_URL=postgres://daruma:daruma@localhost:5432/daruma

# Public origin of the app (the web dev server; Vite proxies /api to Nest).
BETTER_AUTH_URL=http://localhost:3000
# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# OAuth client from Google Cloud Console. Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Entrar como dev" on the login page. Refused when NODE_ENV=production.
DEV_LOGIN=true
# Card images, one folder per user. Relative to apps/api.
UPLOADS_DIR=uploads
