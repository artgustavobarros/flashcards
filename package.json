{
  "name": "daruma",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "ultracite check",
    "db:down": "docker compose down",
    "db:up": "docker compose up -d --wait",
    "predev": "pnpm --filter @daruma/shared build",
    "dev": "pnpm --parallel --filter @daruma/shared --filter @daruma/api --filter @daruma/web dev",
    "fix": "ultracite fix",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "ultracite": "8.0.1"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  }
}
